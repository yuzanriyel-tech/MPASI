<%- include('partials/header', { title, active }) %>
<section class="content">
  <div class="page-title">
    <h1>Akun Pengguna</h1>
    <p>Kelola akun Karyawan dan Pengelola. Akun nonaktif tidak dapat Login.</p>
  </div>

  <div class="toolbar"><span class="grow"></span><a class="btn primary" href="/akun/baru">Tambah akun</a></div>

  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Nama</th><th>Username</th><th>Peran</th><th>Status</th><th>Aksi</th></tr></thead>
      <tbody>
      <% akun.forEach(a => { const diri = a.username === user.username; %>
        <tr>
          <td data-label="Nama"><strong><%= a.nama %></strong><% if (diri) { %> <small class="sub">(Anda)</small><% } %></td>
          <td data-label="Username"><%= a.username %></td>
          <td data-label="Peran"><%= a.peran %></td>
          <td data-label="Status"><span class="badge <%= a.aktif ? 'aman' : 'netral' %>"><%= a.aktif ? 'Aktif' : 'Nonaktif' %></span></td>
          <td data-label="Aksi">
            <div class="row-actions">
              <a class="btn secondary" href="/akun/<%= a.username %>/edit">Edit</a>
              <% if (!diri && a.aktif) { %>
                <button type="button" class="btn danger-outline" data-open-dialog="dlg-<%= a.username %>">Nonaktifkan</button>
              <% } else if (!diri && !a.aktif) { %>
                <form method="post" action="/akun/<%= a.username %>/aktifkan"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn secondary" type="submit">Aktifkan</button></form>
              <% } %>
            </div>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
  <p class="footnote">Akun sendiri tidak memiliki aksi Nonaktifkan.</p>

  <% akun.filter(a => a.aktif && a.username !== user.username).forEach(a => { %>
  <dialog class="dialog" id="dlg-<%= a.username %>" aria-labelledby="dlg-t-<%= a.username %>">
    <form method="post" action="/akun/<%= a.username %>/nonaktifkan">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <h2 id="dlg-t-<%= a.username %>">Nonaktifkan akun <%= a.nama %>?</h2>
      <p class="muted">Username: <%= a.username %> · <%= a.peran %></p>
      <p>Akun ini tidak dapat Login setelah dinonaktifkan. Riwayat transaksi <%= a.nama %> tetap tersimpan.</p>
      <div class="actions">
        <button type="button" class="btn secondary" data-close-dialog>Batal</button>
        <button type="submit" class="btn danger">Nonaktifkan</button>
      </div>
    </form>
  </dialog>
  <% }) %>
</section>
<%- include('partials/footer') %>
