<%- include('partials/header-min', { title }) %>
<main class="auth-wrap">
  <form class="auth-card" method="post" action="/login" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="auth-head">
      <h1>Selamat datang kembali</h1>
      <p class="muted">Login untuk melanjutkan pengelolaan persediaan bahan baku.</p>
    </div>

    <% if (error) { %>
      <div class="alert err" role="alert">
        <%- icon('circle-alert', 20) %>
        <div><strong><%= error.judul %></strong><p><%= error.isi %></p></div>
      </div>
    <% } %>

    <% const errs = typeof errors !== 'undefined' ? errors : {}; %>
    <div class="field <%= errs.username ? 'has-error' : '' %>">
      <label for="username">Username</label>
      <div class="control"><input id="username" name="username" type="text" autocomplete="username" autofocus placeholder="Masukkan username" value="<%= values.username || '' %>"></div>
      <% if (errs.username) { %><p class="err"><%= errs.username %></p><% } %>
    </div>

    <div class="field <%= errs.password ? 'has-error' : '' %>">
      <label for="password">Password</label>
      <div class="control">
        <input id="password" name="password" type="password" autocomplete="current-password" placeholder="Masukkan password">
        <button type="button" class="icon-btn" aria-label="Tampilkan password" data-toggle-password="#password"><%- icon('eye-off', 18) %></button>
      </div>
      <% if (errs.password) { %><p class="err"><%= errs.password %></p><% } %>
    </div>

    <button type="submit" class="btn primary block">Login</button>

    <div class="help-box">
      <strong>Butuh akses akun?</strong>
      <p>Hubungi Pengelola untuk pembuatan akun atau pengaturan ulang password.</p>
    </div>
  </form>
</main>
<script src="/js/app.js" defer></script>
</body></html>
