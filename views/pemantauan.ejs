<%- include('partials/header', { title, active }) %>
<section class="content">
  <div class="page-title">
    <h1>Pemantauan Stok Minimum Bulanan</h1>
    <p>Pantau saldo awal, penerimaan, pemakaian, dan saldo akhir per bahan pada <%= bulanLabel %>.</p>
  </div>

  <% const NAMA_BULAN = f.BULAN; const bulanAktif = Number(bulan.slice(5)); const tahunAktif = Number(bulan.slice(0, 4)); %>
  <div class="toolbar">
    <div class="field grow">
      <span class="label" id="lbl-periode">Periode</span>
      <div class="dropdown month-picker" data-dropdown>
        <button type="button" class="control month-btn" aria-labelledby="lbl-periode" aria-haspopup="true" aria-expanded="<%= bukaPemilih %>" data-dropdown-toggle>
          <%- icon('calendar-days', 18) %><span><%= bulanLabel %></span><%- icon('chevron-down', 18) %>
        </button>
        <div class="dropdown-panel month-panel" <%= bukaPemilih ? '' : 'hidden' %>>
          <div class="month-year">
            <a class="icon-btn" aria-label="Tahun sebelumnya" href="/pemantauan?bulan=<%= bulan %>&th=<%= tahunPanel - 1 %>&buka=1"><%- icon('chevron-right', 18, 'flip') %></a>
            <strong><%= tahunPanel %></strong>
            <a class="icon-btn" aria-label="Tahun berikutnya" href="/pemantauan?bulan=<%= bulan %>&th=<%= tahunPanel + 1 %>&buka=1"><%- icon('chevron-right', 18) %></a>
          </div>
          <div class="month-grid">
            <% NAMA_BULAN.forEach((nm, i) => { const ym = tahunPanel + '-' + String(i + 1).padStart(2, '0'); const aktif = tahunPanel === tahunAktif && i + 1 === bulanAktif; %>
              <a class="<%= aktif ? 'is-active' : '' %>" href="/pemantauan?bulan=<%= ym %>" <%- aktif ? 'aria-current="true"' : '' %>><%= nm.slice(0, 3) %></a>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (!kosong) { %>
  <div class="summary">
    <div class="card"><span>Bahan dipantau</span><strong><%= baris.length %></strong><small>bahan</small></div>
    <div class="card bahaya"><span>Perlu dipesan</span><strong><%= perluCount %></strong><small>bahan</small></div>
    <div class="card aman"><span>Stok aman</span><strong><%= amanCount %></strong><small>bahan</small></div>
  </div>
  <% } %>

  <% if (kosong) { %>
    <div class="empty">
      <%- icon('inbox', 32) %>
      <h3>Data tidak ditemukan</h3>
      <p>Belum ada transaksi pada <%= bulanLabel %>. Ubah periode untuk melihat bulan lain.</p>
    </div>
  <% } else { %>
    <% if (perluCount) { %>
      <div class="alert err"><%- icon('circle-alert', 20) %><div><strong><%= perluCount %> bahan di bawah atau sama dengan minimum</strong><p>Saldo akhir <%= bulanLabel %> perlu ditinjau untuk pemesanan ulang.</p></div></div>
    <% } %>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Bahan</th><th>Saldo awal</th><th>Masuk</th><th>Keluar</th><th>Saldo akhir</th><th>Minimum</th><th>Status</th></tr></thead>
        <tbody>
        <% baris.forEach(r => { const u = r.b.satuanPakai; %>
          <tr>
            <td data-label="Bahan"><div class="ident"><strong><%= r.b.nama %></strong><small><%= r.b.kode %></small></div></td>
            <td data-label="Saldo awal"><%= f.angka(r.awal) %> <%= u %></td>
            <td data-label="Masuk">+<%= f.angka(r.masuk) %> <%= u %></td>
            <td data-label="Keluar">−<%= f.angka(r.keluar) %> <%= u %></td>
            <td data-label="Saldo akhir"><span class="saldo <%= r.perlu ? 'bahaya' : '' %>"><%= f.angka(r.akhir) %> <%= u %></span></td>
            <td data-label="Minimum"><%= f.angka(r.b.minimum) %> <%= u %></td>
            <td data-label="Status"><span class="badge <%= r.perlu ? 'bahaya' : 'aman' %>"><span class="mark" aria-hidden="true"><%= r.perlu ? '!' : '✓' %></span> <%= r.perlu ? 'Perlu dipesan ulang' : 'Aman' %></span></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
  <p class="footnote">Saldo berbeda satuan tidak dijumlahkan. Status dinilai dari saldo akhir periode terhadap minimum stok.</p>
</section>
<%- include('partials/footer') %>
