<%- include('partials/header', { title, active }) %>
<section class="content">
  <div class="page-title">
    <h1>Pemantauan Bulanan</h1>
    <p>Prioritaskan pemesanan berdasarkan minimum dan kedaluwarsa.</p>
  </div>

  <% const NAMA_BULAN = f.BULAN; const bulanAktif = Number(bulan.slice(5)); const tahunAktif = Number(bulan.slice(0, 4)); %>
  <div class="panel filter-card">
    <div class="field">
      <span class="label" id="lbl-periode">Bulan pemantauan</span>
      <div class="dropdown month-picker" data-dropdown>
        <button type="button" class="control month-btn" aria-labelledby="lbl-periode" aria-haspopup="true" aria-expanded="<%= bukaPemilih %>" data-dropdown-toggle>
          <%- icon('calendar-days', 18) %><span><%= bulanLabel %></span><%- icon('chevron-down', 18) %>
        </button>
        <div class="dropdown-panel month-panel" <%= bukaPemilih ? '' : 'hidden' %>>
          <div class="month-year">
            <a class="icon-btn" aria-label="Tahun sebelumnya" href="/pemantauan?bulan=<%= bulan %>&th=<%= tahunPanel - 1 %>&buka=1"><%- icon('chevron-right', 18, 'flip') %></a>
            <strong><%= tahunPanel %></strong>
            <a class="icon-btn" aria-label="Tahun berikutnya" href="/pemantauan?bulan=<%= bulan %>&th=<%= tahunPanel + 1 %>&buka=1"><%- icon('chevron-right', 18) %></a>
          </div>
          <div class="month-grid">
            <% NAMA_BULAN.forEach((nm, i) => { const ym = tahunPanel + '-' + String(i + 1).padStart(2, '0'); const aktif = tahunPanel === tahunAktif && i + 1 === bulanAktif; %>
              <a class="<%= aktif ? 'is-active' : '' %>" href="/pemantauan?bulan=<%= ym %>" <%- aktif ? 'aria-current="true"' : '' %>><%= nm.slice(0, 3) %></a>
            <% }) %>
          </div>
        </div>
      </div>
      <p class="hint">Menampilkan saldo ≤ minimum dan batch yang mendekati kedaluwarsa pada bulan dipilih.</p>
    </div>
  </div>

  <% if (aman) { %>
    <div class="empty">
      <%- icon('inbox', 32) %>
      <h3>Stok aman</h3>
      <p>Seluruh saldo di atas minimum. Tidak ada batch mendekati kedaluwarsa pada <%= bulanLabel %>.</p>
    </div>
  <% } else { %>
    <div class="summary">
      <div class="card"><strong><%= perluList.length %> bahan</strong><small>Saldo ≤ minimum</small></div>
      <div class="card"><strong><%= batchBulan.length %> batch</strong><small>Kedaluwarsa bulan ini</small></div>
    </div>

    <% if (perluList.length) { %>
      <div class="alert err">
        <%- icon('circle-alert', 20) %>
        <div>
          <% if (perluList.length === 1) { const r = perluList[0]; %>
            <strong>Pesan ulang <%= r.b.nama %></strong>
            <p>Saldo <%= f.angka(r.saldo) %> <%= r.b.satuanPakai %> ≤ minimum <%= f.angka(r.b.minimum) %> <%= r.b.satuanPakai %>. Rekomendasi: <%= f.angka(r.jumlahBeli) %> <%= r.b.satuanBeli %> = <%= f.angka(r.jumlahPakai) %> <%= r.b.satuanPakai %><%= r.pemasok ? ', dari ' + r.pemasok : '' %>.</p>
          <% } else { %>
            <strong>Pesan ulang <%= perluList.length %> bahan</strong>
            <% perluList.forEach(r => { %>
              <p><b><%= r.b.nama %></b>: saldo <%= f.angka(r.saldo) %> ≤ minimum <%= f.angka(r.b.minimum) %> <%= r.b.satuanPakai %>. Rekomendasi: <%= f.angka(r.jumlahBeli) %> <%= r.b.satuanBeli %> = <%= f.angka(r.jumlahPakai) %> <%= r.b.satuanPakai %><%= r.pemasok ? ', dari ' + r.pemasok : '' %>.</p>
            <% }) %>
          <% } %>
        </div>
      </div>
    <% } %>

    <% if (rekomendasi.length) { %>
    <div class="list-title"><h2>Rekomendasi pemesanan</h2></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Bahan</th><th>Saldo / minimum</th><th>Alasan</th><th>Rekomendasi</th><th>Pemasok</th></tr></thead>
        <tbody>
        <% rekomendasi.forEach(r => { const u = r.b.satuanPakai; %>
          <tr>
            <td data-label="Bahan"><div class="ident"><strong><%= r.b.nama %></strong><small><%= r.b.kode %></small></div></td>
            <td data-label="Saldo / minimum"><span class="saldo-kecil <%= r.perlu ? 'bahaya' : '' %>"><%= f.angka(r.saldo) %> <%= u %></span> / <%= f.angka(r.b.minimum) %> <%= u %></td>
            <td data-label="Alasan">
              <% if (r.perlu) { %>
                <span class="badge bahaya"><span class="mark" aria-hidden="true">!</span> Perlu dipesan ulang</span>
                <% if (r.adaBatch) { %><small class="sub alasan-extra">Batch kedaluwarsa bulan ini</small><% } %>
              <% } else { %>Mendekati kedaluwarsa · <%= bulanLabel %><% } %>
            </td>
            <td data-label="Rekomendasi"><strong><%= f.angka(r.jumlahBeli) %> <%= r.b.satuanBeli %> = <%= f.angka(r.jumlahPakai) %> <%= u %></strong><% if (!r.perlu) { %><small class="sub">untuk antisipasi</small><% } %></td>
            <td data-label="Pemasok"><%= r.pemasok || '—' %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>

    <% if (batchBulan.length) { %>
    <div class="list-title"><h2>Batch mendekati kedaluwarsa</h2></div>
    <div class="table-wrap">
      <table class="table">
        <thead><tr><th>Bahan</th><th>Kode batch</th><th>Sisa batch</th><th>Tanggal kedaluwarsa</th><th>Alasan</th></tr></thead>
        <tbody>
        <% batchBulan.forEach(x => { %>
          <tr>
            <td data-label="Bahan"><div class="ident"><strong><%= x.bahan.nama %></strong><small><%= x.kode %></small></div></td>
            <td data-label="Kode batch"><%= x.kodeBatch %></td>
            <td data-label="Sisa batch"><strong><%= f.angka(x.sisa) %> <%= x.bahan.satuanPakai %></strong></td>
            <td data-label="Tanggal kedaluwarsa"><%= f.tanggalID(x.kedaluwarsa) %></td>
            <td data-label="Alasan">Kedaluwarsa di bulan dipilih</td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } %>

  <div class="alert info">
    <%- icon('info', 20) %>
    <div><strong>FEFO berjalan otomatis</strong><p>Batch dengan kedaluwarsa terdekat digunakan lebih dulu. Rekomendasi ini membantu keputusan pemesanan, bukan mencatat transaksi.</p></div>
  </div>
</section>
<%- include('partials/footer') %>
